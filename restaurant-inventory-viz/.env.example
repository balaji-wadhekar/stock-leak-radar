# ==============================================================================
# Restaurant Inventory & Variance Data Visualization
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_inventory_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=restaurant_inventory

# Standard SQLAlchemy / Psycopg connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/restaurant_inventory_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# Streamlit Web Application Configuration
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_BASE=light
STREAMLIT_THEME_PRIMARY_COLOR=#1E3A8A

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Anomaly & Leak Detection Thresholds
CRITICAL_VARIANCE_PCT_THRESHOLD=10.0   # Flag items with unexplained variance > 10%
CRITICAL_VARIANCE_COST_THRESHOLD=50.0   # Flag items with unexplained dollar loss > $50
